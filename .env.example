# Copy this file to .env (gitignored) and fill in real values locally.
# Never commit .env or paste real keys into chat/GitHub/group chats.

# Roboflow-hosted ball model (ai/config.py). Leave both blank to keep using
# a local models/best.pt (or the stock yolov8n.pt fallback) instead.
PICKLEVISION_ROBOFLOW_MODEL_ID=pickleball-prototype/3
PICKLEVISION_ROBOFLOW_API_KEY=

# Only needed for the self-hosted HTTP server path (PICKLEVISION_ROBOFLOW_SERVER=1),
# not for the default in-process roboflow_local path.
# PICKLEVISION_ROBOFLOW_WORKSPACE_NAME=franzs-workspace-utuz0
